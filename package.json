{
    "name":  "dsh-qq-sounds",
    "version":  "1.0.8",
    "description":  "用本机 QQ 的音效提醒 DSH：任务完成响「好友消息」，需要你放权限 / 回答问题时响「系统消息」。Windows 下自动探测 QQ 音效目录，未安装或其它平台回落到内置仿 QQ 合成音。QQ-style notification sounds for DeepSeek Harness.",
    "type":  "module",
    "exports":  {
                    ".":  "./lib/host.js",
                    "./client":  "./lib/client.js",
                    "./cordis.patch.yml":  "./cordis.patch.yml",
                    "./package.json":  "./package.json"
                },
    "files":  [
                  "lib",
                  "assets",
                  "cordis.patch.yml",
                  "README.md",
                  "README.en.md",
                  "LICENSE"
              ],
    "scripts":  {
                    "test":  "node --test test/*.test.mjs",
                    "pack:check":  "npm pack --dry-run"
                },
    "keywords":  [
                     "dsh",
                     "dsh-plugin",
                     "deepseek-harness",
                     "notification",
                     "sound",
                     "qq",
                     "alert",
                     "approval"
                 ],
    "author":  "gexiubin",
    "license":  "MIT",
    "repository":  {
                       "type":  "git",
                       "url":  "git+https://github.com/GeXiubinHelloWorld/dsh-qq-sounds.git"
                   },
    "bugs":  {
                 "url":  "https://github.com/GeXiubinHelloWorld/dsh-qq-sounds/issues"
             },
    "homepage":  "https://github.com/GeXiubinHelloWorld/dsh-qq-sounds#readme",
    "engines":  {
                    "node":  "\u003e=22"
                },
    "dsh":  {
                "manifestVersion":  1,
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           },
                "client":  {
                               "platform":  "web"
                           }
            }
}
